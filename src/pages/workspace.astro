---
import ManagerLayout from "../layouts/ManagerLayout.astro";
---
<ManagerLayout page="workspace" title="Mizuki - 博客编辑">
  <p id="message" class="workspace-message" role="status">正在打开博客…</p>
  <iframe id="blog" class="blog-frame" title="Mizuki 博客" hidden></iframe>
  <script>
    const frame = document.getElementById("blog") as HTMLIFrameElement;
    const message = document.getElementById("message")!;
    const reload = document.getElementById("reloadBlog") as HTMLButtonElement;
    async function openBlog() {
      let session: { codeRoot?: string; previewUrl?: string } | null = null;
      try { session = JSON.parse(sessionStorage.getItem("mcm-workspace") || "null"); } catch {}
      if (!session?.previewUrl) {
        const response = await fetch("/api/config");
        const { config } = await response.json();
        if (!config.codeRoot) throw new Error("请先选择仓库");
        const stateResponse = await fetch("/api/preview/status", { method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({project: {codeRoot: config.codeRoot}}) });
        const state = await stateResponse.json();
        if (!state.ready || !state.previewUrl) throw new Error("博客未运行");
        session = {codeRoot: config.codeRoot, previewUrl: state.previewUrl};
        sessionStorage.setItem("mcm-workspace", JSON.stringify(session));
      }
      const url = new URL(session.previewUrl!);
      if (!["localhost", "127.0.0.1", "[::1]"].includes(url.hostname) || !["http:", "https:"].includes(url.protocol) || url.username || url.password) throw new Error("无效的本地预览地址");
      frame.src = url.href;
      frame.hidden = false;
      message.hidden = true;
      reload.disabled = false;
      reload.addEventListener("click", () => { frame.src = url.href; });
    }
    void openBlog().catch(() => { message.textContent = "博客未运行，请点击底部“启动页”启动博客。"; });
  </script>
</ManagerLayout>
