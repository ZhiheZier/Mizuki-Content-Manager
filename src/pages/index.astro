---
import ManagerLayout from "../layouts/ManagerLayout.astro";
---
<ManagerLayout page="launcher">
  <main>
      <div class="heading"><span class="eyebrow">本地工作区</span><h1>打开博客</h1><p>选择你的 Mizuki 代码仓库。</p></div>
      <form id="projectForm">
        <label for="codeRoot">代码仓库路径</label>
        <div class="path-row"><input id="codeRoot" name="codeRoot" placeholder="D:/Projects/your-mizuki-blog" autocomplete="off" required /><button id="confirmProject" type="submit">确定</button></div>
      </form>
      <section id="projectDetails" hidden aria-label="仓库信息">
        <div class="section-head"><h2>仓库信息</h2><span id="contentMode" class="badge"></span></div>
        <dl><dt>代码仓库</dt><dd id="repoPath"></dd><dt>内容目录</dt><dd id="contentPath"></dd><dt id="remoteLabel" hidden>内容仓库</dt><dd id="remotePath" hidden></dd></dl>
        <p id="syncNotice" class="notice" hidden>启动前检查内容仓库状态。内容同步方式由所选博客的启动脚本决定。</p>
      </section>
      <div class="launch-row"><span id="status" role="status" aria-live="polite">等待选择仓库</span><button id="launch" class="primary" disabled>启动并进入博客</button></div>
      <section id="gitBlock" class="notice" hidden><p id="gitMessage"></p><button id="push" type="button">提交并推送内容</button><button id="retry" type="button">重新检查并启动</button></section>
      <footer><span>Mizuki Content Manager</span><span>内容编辑与预览</span></footer>
      </main>
  <script src="../scripts/launcher.ts"></script>
</ManagerLayout>
