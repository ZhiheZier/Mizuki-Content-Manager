---
import Icon from "../components/Icon.astro";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon/favicon.ico" sizes="64x64" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("mcm-theme");
        document.documentElement.classList.toggle("dark", theme === "dark" || (!theme && matchMedia("(prefers-color-scheme: dark)").matches));
        const hue = localStorage.getItem("mcm-hue");
        if (hue !== null && Number.isFinite(Number(hue))) document.documentElement.style.setProperty("--hue", String(Math.max(0, Math.min(360, Number(hue)))));
      } catch {}
    </script>
    <title>Mizuki Content Manager</title>
  </head>
  <body>
    <header>
      <div class="nav-inner">
        <a class="brand" href="/" aria-label="Mizuki Content Manager"><img src="/theme/mizuki-icon.webp" alt="" width="28" height="28" /><span>Mizuki CM</span></a>
        <nav aria-label="主导航">
          <a class="nav-link active" href="/" aria-current="page">启动页</a>
          <button id="blogEditor" class="nav-link" type="button" disabled>博客编辑</button>
          <a class="nav-link" href="#logs">运行日志</a>
        </nav>
        <div class="nav-tools">
          <button id="appearanceToggle" class="icon-button" type="button" title="外观设置" aria-label="外观设置" aria-expanded="false" aria-controls="appearancePanel"><Icon name="Palette" /></button>
          <button id="themeToggle" class="icon-button" type="button" title="切换深色模式" aria-label="切换深色模式" aria-pressed="false"><Icon name="Sun" class="sun-icon" /><Icon name="Moon" class="moon-icon" /></button>
          <div id="appearancePanel" class="appearance-panel" hidden>
            <div class="section-head"><label for="themeHue">主题色</label><span class="color-preview" aria-hidden="true"></span></div>
            <input id="themeHue" type="range" min="0" max="360" value="240" />
            <div class="hue-presets">
              {[{hue: 240, name: "蓝色"}, {hue: 160, name: "绿色"}, {hue: 30, name: "珊瑚色"}, {hue: 345, name: "粉色"}, {hue: 290, name: "紫色"}].map(({hue, name}) => <button class="hue-preset" type="button" data-hue={hue} style={`--swatch: oklch(.70 .14 ${hue})`} aria-label={name} title={name} aria-pressed={hue === 240}></button>)}
            </div>
          </div>
        </div>
      </div>
    </header>
    <main>
      <div class="heading"><span class="eyebrow">本地工作区</span><h1>打开博客</h1><p>选择你的 Mizuki 代码仓库。</p></div>
      <form id="projectForm">
        <label for="codeRoot">代码仓库路径</label>
        <div class="path-row"><input id="codeRoot" name="codeRoot" placeholder="D:/Projects/your-mizuki-blog" autocomplete="off" required /><button id="confirmProject" type="submit">确定</button></div>
      </form>
      <section id="projectDetails" hidden aria-label="仓库信息">
        <div class="section-head"><h2>仓库信息</h2><span id="contentMode" class="badge"></span></div>
        <dl><dt>代码仓库</dt><dd id="repoPath"></dd><dt>内容目录</dt><dd id="contentPath"></dd><dt id="remoteLabel" hidden>内容仓库</dt><dd id="remotePath" hidden></dd></dl>
        <p id="syncNotice" class="notice" hidden>启动前检查内容仓库状态。内容同步方式由所选博客的启动脚本决定。</p>
      </section>
      <div class="launch-row"><span id="status" role="status" aria-live="polite">等待选择仓库</span><button id="launch" class="primary" disabled>启动并进入博客</button></div>
      <section id="gitBlock" class="notice" hidden><p id="gitMessage"></p><button id="push" type="button">提交并推送内容</button><button id="retry" type="button">重新检查并启动</button></section>
      <section id="logs" class="logs"><div class="section-head"><h2>运行日志</h2><button id="clearLog" class="text-button" type="button">清空显示</button></div><pre id="log" aria-live="polite">暂无日志</pre></section>
      <footer><span>Mizuki Content Manager</span><span>内容编辑与预览</span></footer>
    </main>
    <script src="../scripts/launcher.ts"></script>
    <script>
      const toggle = document.getElementById("themeToggle") as HTMLButtonElement;
      function updateThemeButton() {
        const dark = document.documentElement.classList.contains("dark");
        const label = dark ? "切换浅色模式" : "切换深色模式";
        toggle.setAttribute("aria-pressed", String(dark));
        toggle.setAttribute("aria-label", label);
        toggle.title = label;
      }
      updateThemeButton();
      toggle.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        try { localStorage.setItem("mcm-theme", dark ? "dark" : "light"); } catch {}
        updateThemeButton();
      });
      const appearanceButton = document.getElementById("appearanceToggle") as HTMLButtonElement;
      const panel = document.getElementById("appearancePanel")!;
      const hueInput = document.getElementById("themeHue") as HTMLInputElement;
      const swatches = Array.from(document.querySelectorAll<HTMLButtonElement>(".hue-preset"));
      function updateHue(value: string) {
        document.documentElement.style.setProperty("--hue", value);
        swatches.forEach((swatch) => swatch.setAttribute("aria-pressed", String(swatch.dataset.hue === value)));
      }
      hueInput.value = getComputedStyle(document.documentElement).getPropertyValue("--hue").trim();
      updateHue(hueInput.value);
      function setPanel(open: boolean) {
        panel.hidden = !open;
        appearanceButton.setAttribute("aria-expanded", String(open));
      }
      appearanceButton.addEventListener("click", () => setPanel(panel.hidden));
      hueInput.addEventListener("input", () => {
        updateHue(hueInput.value);
        try { localStorage.setItem("mcm-hue", hueInput.value); } catch {}
      });
      swatches.forEach((swatch) => swatch.addEventListener("click", () => {
        hueInput.value = swatch.dataset.hue!;
        updateHue(hueInput.value);
        try { localStorage.setItem("mcm-hue", hueInput.value); } catch {}
      }));
      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !panel.contains(event.target) && !appearanceButton.contains(event.target)) setPanel(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !panel.hidden) { setPanel(false); appearanceButton.focus(); }
      });
    </script>
  </body>
</html>
<style>
  :global(:root) {
    --hue: 240;
    --primary: oklch(.70 .14 var(--hue));
    --page-bg: oklch(.95 .01 var(--hue));
    --card-bg: white;
    --btn-bg: oklch(.95 .025 var(--hue));
    --btn-hover: oklch(.90 .05 var(--hue));
    --btn-content: oklch(.55 .12 var(--hue));
    --text: #30343b;
    --muted: #727782;
    --line: #e6e9ef;
    --field-bg: #f5f7fa;
    --notice-bg: #fbf7e9;
    --notice-text: #806e37;
    --radius: 16px;
    color-scheme: light;
  }
  :global(:root.dark) {
    --primary: oklch(.75 .14 var(--hue));
    --page-bg: oklch(.16 .014 var(--hue));
    --card-bg: oklch(.23 .015 var(--hue));
    --btn-bg: oklch(.33 .035 var(--hue));
    --btn-hover: oklch(.38 .04 var(--hue));
    --btn-content: oklch(.75 .10 var(--hue));
    --text: #e3e5e9;
    --muted: #a3a8b2;
    --line: #353c46;
    --field-bg: #252b34;
    --notice-bg: #342f22;
    --notice-text: #d6c591;
    color-scheme: dark;
  }
  :global(*) { box-sizing: border-box; }
  :global([hidden]) { display: none !important; }
  :global(body) { margin: 0; color: var(--text); background: var(--page-bg); font-family: ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"; font-size: 14px; font-weight: 400; font-synthesis: none; letter-spacing: 0; line-height: 1.6; transition: background .2s, color .2s; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 100px; }
  header { position: sticky; top: 12px; z-index: 20; padding: 12px 24px 0; }
  .nav-inner { max-width: 1100px; margin: auto; height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 20px; background: var(--card-bg); border-radius: 12px; box-shadow: 0 2px 8px rgb(0 0 0 / .05); }
  .brand { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; color: var(--text); text-decoration: none; font-size: 18px; font-weight: 400; white-space: nowrap; }
  .brand img { display: block; width: 28px; height: 28px; object-fit: contain; }
  nav { display: flex; align-items: center; gap: 4px; }
  .nav-link { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 16px; border-radius: 8px; color: var(--text); white-space: nowrap; }
  button.nav-link { background: transparent; }
  .brand:hover, .nav-link:hover, .icon-button:hover { background: var(--btn-bg); color: var(--btn-content); }
  .nav-link.active { background: var(--btn-bg); color: var(--btn-content); }
  .nav-tools { position: relative; display: flex; align-items: center; gap: 4px; }
  .icon-button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; flex-shrink: 0; background: transparent; color: var(--text); }
  #themeToggle :global(.moon-icon) { display: none; }
  :global(.dark) #themeToggle :global(.moon-icon) { display: block; }
  :global(.dark) #themeToggle :global(.sun-icon) { display: none; }
  .appearance-panel { position: absolute; top: 58px; right: 0; width: 236px; padding: 20px; background: var(--card-bg); border-radius: 12px; box-shadow: 0 6px 24px rgb(0 0 0 / .12); border: 1px solid var(--line); }
  .appearance-panel label { margin: 0; }
  .color-preview { width: 18px; height: 18px; border-radius: 50%; background: var(--primary); }
  #themeHue { width: 100%; height: 24px; margin: 18px 0 10px; padding: 0; accent-color: var(--primary); cursor: pointer; }
  .hue-presets { display: flex; justify-content: space-between; gap: 8px; }
  .hue-preset { min-height: 24px; width: 24px; height: 24px; padding: 0; border-radius: 50%; background: var(--swatch); border: 3px solid var(--card-bg); outline: 1px solid transparent; }
  .hue-preset:hover:not(:disabled) { background: var(--swatch); outline-color: var(--muted); }
  .hue-preset[aria-pressed="true"] { outline-color: var(--text); }
  h1 { margin: 8px 0 0; font-size: 26px; font-weight: 400; line-height: 1.3; }
  .eyebrow { color: var(--muted); font-size: 12px; }
  main { max-width: 900px; margin: 0 auto; padding: 36px 32px 28px; }
  .heading h1::before, .section-head h2::before { content: ''; display: inline-block; width: 4px; height: .9em; border-radius: 4px; margin-right: 10px; background: var(--primary); }
  .heading p { color: var(--muted); margin: 10px 0 24px; }
  label { display: block; font-weight: 400; margin-bottom: 10px; }
  .path-row { display: flex; gap: 10px; }
  input { flex: 1; min-width: 0; height: 44px; border: 1px solid var(--line); border-radius: 8px; background: var(--card-bg); color: var(--text); padding: 0 14px; font: inherit; }
  input:read-only { background: var(--field-bg); color: var(--muted); }
  button { min-height: 40px; border: 0; border-radius: 8px; background: var(--btn-bg); color: var(--btn-content); padding: 0 18px; font: inherit; cursor: pointer; transition: background .15s, color .15s; }
  .path-row button { height: 44px; }
  button:hover:not(:disabled) { background: var(--btn-hover); }
  button:disabled { opacity: .5; cursor: default; }
  input:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  #projectDetails { border-top: 1px solid var(--line); margin-top: 24px; padding-top: 22px; }
  .section-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  h2 { margin: 0; font-size: 14px; font-weight: 400; }
  .badge { color: var(--btn-content); background: var(--btn-bg); border-radius: 6px; padding: 4px 10px; font-size: 12px; }
  dl { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 14px; margin: 22px 0; }
  dt { color: var(--muted); } dd { margin: 0; overflow-wrap: anywhere; }
  .notice { padding: 12px 16px; background: var(--notice-bg); border-left: 3px solid #c8b56d; border-radius: 0 8px 8px 0; color: var(--notice-text); line-height: 1.7; }
  .notice p { margin: 0 0 12px; white-space: pre-wrap; overflow-wrap: anywhere; }
  #gitBlock button { margin: 4px 8px 4px 0; }
  .launch-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 26px 0; }
  #status { color: var(--muted); } .primary { background: var(--btn-bg); color: var(--btn-content); min-height: 44px; }
  .primary:hover:not(:disabled) { background: var(--btn-hover); }
  .primary.is-running { background: #fbe9e9; color: #a53039; }
  .primary.is-running:hover:not(:disabled) { background: #f6d7d9; }
  :global(.dark) .primary.is-running { background: #44282d; color: #ffb6bc; }
  :global(.dark) .primary.is-running:hover:not(:disabled) { background: #553038; }
  .logs { border-top: 1px solid var(--line); padding-top: 18px; margin-top: 8px; }
  .text-button { border: none; background: transparent; color: var(--muted); font-size: 12px; min-height: 30px; padding: 0 8px; }
  pre { height: 180px; overflow: auto; padding: 18px; margin: 12px 0 0; border: 0; border-radius: var(--radius); background: var(--card-bg); color: var(--muted); font: inherit; font-size: 12px; line-height: 1.8; white-space: pre-wrap; overflow-wrap: anywhere; scrollbar-width: thin; scrollbar-color: var(--btn-hover) transparent; }
  footer { margin-top: 24px; display: flex; justify-content: space-between; gap: 16px; font-size: 12px; color: var(--muted); } a { color: var(--btn-content); text-decoration: none; } a:hover { color: var(--primary); }
  @media (max-width: 600px) { header { padding: 8px 12px 0; top: 8px; } .nav-inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; height: auto; padding: 8px; gap: 6px; } .brand { padding: 6px 8px; font-size: 16px; } .nav-tools { grid-column: 2; grid-row: 1; } nav { grid-column: 1 / -1; grid-row: 2; justify-content: center; } .nav-link { min-height: 38px; padding: 0 14px; } main { padding: 28px 20px; } .launch-row { align-items: stretch; flex-direction: column; } footer { flex-wrap: wrap; } }
  @media (prefers-reduced-motion: reduce) { :global(*) { transition: none !important; } }
</style>
