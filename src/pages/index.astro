---
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon/favicon.ico" sizes="64x64" />
    <title>Mizuki Content Manager</title>
  </head>
  <body>
    <header><img src="/logo.png" alt="Mizuki" width="122" height="40" /><span>Content Manager</span><span class="local">本地工作区</span></header>
    <main>
      <div class="heading"><h1>打开博客</h1><p>选择你的 Mizuki 代码仓库。</p></div>
      <form id="projectForm">
        <label for="codeRoot">代码仓库路径</label>
        <div class="path-row"><input id="codeRoot" name="codeRoot" placeholder="D:/Projects/your-mizuki-blog" autocomplete="off" required /><button id="confirmProject" type="submit">确定</button></div>
      </form>
      <section id="projectDetails" hidden aria-label="仓库信息">
        <div class="section-head"><h2>仓库信息</h2><span id="contentMode" class="badge"></span></div>
        <dl><dt>代码仓库</dt><dd id="repoPath"></dd><dt>内容目录</dt><dd id="contentPath"></dd><dt id="remoteLabel" hidden>内容仓库</dt><dd id="remotePath" hidden></dd></dl>
        <p id="syncNotice" class="notice" hidden>启动博客会同步远程内容。请先推送本地变更，避免被覆盖。</p>
      </section>
      <div class="launch-row"><span id="status" role="status" aria-live="polite">等待选择仓库</span><button id="launch" class="primary" disabled>启动并进入博客</button></div>
      <section id="gitBlock" class="notice" hidden><p id="gitMessage"></p><button id="push" type="button">提交并推送内容</button><button id="retry" type="button">重新检查并启动</button></section>
      <section class="logs"><div class="section-head"><h2>运行日志</h2><button id="clearLog" class="text-button" type="button">清空显示</button></div><pre id="log" aria-live="polite">暂无日志</pre></section>
      <footer><a href="/editor">打开现有内容编辑器</a><span>Mizuki Content Manager</span></footer>
    </main>
    <script src="../scripts/launcher.ts"></script>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global([hidden]) { display: none !important; }
  :global(body) { margin: 0; color: #202a35; background: #f6f8fa; font-family: system-ui, sans-serif; font-size: 14px; letter-spacing: 0; }
  header { height: 76px; display: flex; align-items: center; gap: 18px; padding: 0 32px; border-bottom: 1px solid #dde3e9; background: white; }
  header img { object-fit: contain; }
  header > span { font-weight: 600; }
  .local { margin-left: auto; color: #637080; font-size: 12px; }
  main { max-width: 840px; margin: 0 auto; padding: 52px 28px 28px; }
  h1 { margin: 0; font-size: 30px; } .heading p { color: #637080; margin: 10px 0 32px; }
  label { display: block; font-weight: 600; margin-bottom: 10px; }
  .path-row { display: flex; gap: 10px; }
  input { flex: 1; min-width: 0; height: 44px; border: 1px solid #cbd4df; border-radius: 6px; background: white; padding: 0 12px; font: inherit; }
  input:read-only { background: #edf1f5; color: #647080; }
  button { min-height: 40px; border: 1px solid #cbd4df; border-radius: 6px; background: white; color: #202a35; padding: 0 18px; font: inherit; font-weight: 600; cursor: pointer; }
  .path-row button { height: 44px; }
  button:hover:not(:disabled) { background: #edf3fb; }
  button:disabled { opacity: .5; cursor: default; }
  input:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid #2563eb; outline-offset: 3px; }
  #projectDetails { border-top: 1px solid #dde3e9; margin-top: 28px; padding-top: 22px; }
  .section-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  h2 { margin: 0; font-size: 14px; font-weight: 650; }
  .badge { color: #13724f; background: #e6f5ee; border-radius: 4px; padding: 4px 8px; font-size: 12px; }
  dl { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 14px; margin: 22px 0; }
  dt { color: #647080; } dd { margin: 0; overflow-wrap: anywhere; }
  .notice { padding: 14px 16px; background: #fff7de; border-left: 3px solid #c39422; color: #725b20; line-height: 1.7; }
  .notice p { margin: 0 0 12px; white-space: pre-wrap; overflow-wrap: anywhere; }
  #gitBlock button { margin: 4px 8px 4px 0; }
  .launch-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 26px 0; }
  #status { color: #647080; } .primary { background: #2563eb; color: white; border-color: #2563eb; min-height: 44px; }
  .primary:hover:not(:disabled) { background: #1d4ed8; }
  .logs { border-top: 1px solid #dde3e9; padding-top: 18px; margin-top: 12px; }
  .text-button { border: none; background: transparent; color: #647080; font-size: 12px; min-height: 30px; padding: 0 4px; }
  pre { height: 180px; overflow: auto; padding: 16px; margin: 12px 0 0; border: 1px solid #dfe5eb; border-radius: 6px; background: #fff; color: #526172; font: 12px/1.8 ui-monospace, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
  footer { margin-top: 24px; display: flex; justify-content: space-between; gap: 16px; font-size: 12px; color: #7a8694; } a { color: #526172; }
  @media (max-width: 600px) { header { padding: 0 18px; gap: 10px; } header > span { font-size: 12px; } main { padding: 30px 18px; } .launch-row { align-items: stretch; flex-direction: column; } footer { flex-wrap: wrap; } }
</style>
