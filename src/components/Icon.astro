---
import { Palette, Sun, Moon, RefreshCw } from "lucide";
const icons = { Palette, Sun, Moon, RefreshCw };
interface Props { name: keyof typeof icons; class?: string; }
const { name, class: className } = Astro.props;
---
<svg class={className} xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {icons[name].map(([tag, attributes]) => { const Tag = tag; return <Tag {...attributes} />; })}
</svg>
